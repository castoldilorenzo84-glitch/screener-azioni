# ============================================================
# .streamlit/secrets.toml  —  TEMPLATE DI CONFIGURAZIONE
# ============================================================
# 1. Rinomina questo file in: secrets.toml
# 2. Compila i valori con le tue credenziali
# 3. NON caricare mai questo file su GitHub (aggiungi a .gitignore)
#
# Per Streamlit Community Cloud: incolla i valori nella sezione
# "Secrets" del pannello di controllo della tua app.
# ============================================================

# --- Financial Modeling Prep (FMP) ---
# Registrati gratis su: https://financialmodelingprep.com/developer/docs
# Tier Basic = 250 chiamate/giorno (gratuito)
FMP_API_KEY = "la_tua_api_key_fmp_qui"

# --- Google Service Account (per Preferiti su Google Sheets) ---
# Istruzioni complete nel README.md
# Crea un Service Account su: https://console.cloud.google.com
# Scarica il file JSON e copia i valori qui sotto
[gcp_service_account]
type = "service_account"
project_id = "il-tuo-project-id"
private_key_id = "id-della-chiave-privata"
private_key = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
client_email = "nome-service-account@project-id.iam.gserviceaccount.com"
client_id = "123456789"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/nome-service-account%40project-id.iam.gserviceaccount.com"

# --- Configurazione Google Sheets ---
# Il nome del Google Sheet che l'app userà come database Preferiti
# Crea un Google Sheet vuoto con questo nome e condividilo con l'email del Service Account
GSHEET_NAME = "Screener_Preferiti"

# --- Telegram Bot (per notifiche) ---
# Istruzioni complete nella sezione 🔔 Notifiche dell'app
# Passo 1: cerca @BotFather su Telegram → /newbot → copia il token
# Passo 2: scrivi /start al tuo bot → vai su api.telegram.org/bot<TOKEN>/getUpdates → copia "id"
TELEGRAM_BOT_TOKEN = "inserisci_il_token_del_bot_qui"
TELEGRAM_CHAT_ID   = "inserisci_il_tuo_chat_id_qui"
